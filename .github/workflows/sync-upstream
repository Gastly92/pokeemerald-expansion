name: Sync Upstream Mirror

on:
  workflow_dispatch:

jobs:
  fast-forward:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout target branch
        uses: actions/checkout@v4
        with:
          ref: upstream-mirror/upcoming
          fetch-depth: 0

      - name: Force sync from upstream
        run: |
          git remote add upstream https://github.com/rh-hideout/pokeemerald-expansion.git
          git fetch upstream upcoming
          git reset --hard upstream/upcoming
          git push origin upstream-mirror/upcoming --force
